services:
  db:
    image: mysql:8.4
    restart: unless-stopped
    command: ["--lower_case_table_names=1"]
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:?Set MYSQL_ROOT_PASSWORD in the root .env file}
      MYSQL_DATABASE: ${DB_NAME:-station_service}
      MYSQL_USER: ${DB_USER:-station}
      MYSQL_PASSWORD: ${DB_PASSWORD:?Set DB_PASSWORD in the root .env file}
    ports:
      - "3307:3306"
    volumes:
      - station_mysql_data:/var/lib/mysql
      - ./packages/api/sql/migrations:/station-migrations:ro
      - ./packages/api/sql/seed.sql:/station-seed.sql:ro
      - ./docker/mysql/01-init-schema.sh:/docker-entrypoint-initdb.d/01-init-schema.sh:ro
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mysql --protocol=socket --user=root --password="$${MYSQL_ROOT_PASSWORD}"
          "$${MYSQL_DATABASE}" --silent --skip-column-names
          --execute="SELECT COUNT(*) = 1 FROM information_schema.columns
          WHERE table_schema = DATABASE() AND LOWER(table_name) = 'recettecaisse'
          AND LOWER(column_name) = 'ecartcaisse'" | grep -qx 1
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 30s

  api:
    build:
      context: .
      dockerfile: packages/api/Dockerfile
    restart: unless-stopped
    environment:
      DB_HOST: db
      DB_PORT: 3306
      DB_USER: ${DB_USER:-station}
      DB_PASSWORD: ${DB_PASSWORD:?Set DB_PASSWORD in the root .env file}
      DB_NAME: ${DB_NAME:-station_service}
      JWT_SECRET: ${JWT_SECRET:?Set JWT_SECRET in the root .env file}
      PORT: 4000
      CORS_ORIGIN: http://localhost:5173,http://127.0.0.1:5173
    ports:
      - "4000:4000"
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:4000/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

  frontend:
    build:
      context: .
      dockerfile: packages/web/Dockerfile
      args:
        VITE_API_URL: /api
    restart: unless-stopped
    ports:
      - "5173:80"
    depends_on:
      api:
        condition: service_healthy

  nginx:
    image: nginx:1.27-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:80"
    volumes:
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      api:
        condition: service_healthy
      frontend:
        condition: service_started

  phpmyadmin:
    image: phpmyadmin:latest
    restart: unless-stopped
    environment:
      PMA_HOST: db
      PMA_USER: ${DB_USER:-station}
      PMA_PASSWORD: ${DB_PASSWORD}
      
    ports:
      - "8095:80"
    depends_on:
      db:
        condition: service_healthy

volumes:
  station_mysql_data:
